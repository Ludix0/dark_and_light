# Ce projet n'a PAS de .env propre chez Ludix : .env est un lien symbolique vers
# le fichier partagé par tous les serveurs de jeu :
#   ln -sf ${HOME}/volumes/secrets/steam-account.env ${HOME}/projets/dark_and_light/.env
#
# Variables utilisées par docker-compose.yml :
TZ=Europe/Paris
PUID=1000
PGID=1000
# Port de jeu côté hôte (garder 7777 : le port raw 7778 est fixe)
jeux1=7777
# Port de requête Steam (même numéro hôte/conteneur)
steamQuery=27015
# Port RCON (TCP, non publié par défaut)
rcon=27020
maxPlayers=10
# Mots de passe : 5+ caractères, en MAJUSCULES
password=CHANGEME
adminPassword=CHANGEMEADMIN
